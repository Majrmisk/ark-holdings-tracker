@model App.Models.Admin.CreateUserViewModel
@{
    ViewData["Title"] = "Create User";
}

<div class="row mt-4">
    <div class="col-md-5 offset-md-3">
        <h2 class="mb-4">Create User</h2>

        <div class="card shadow-sm">
            <div class="card-body">
                <form asp-area="Admin" asp-controller="Users" asp-action="Create" method="post">
                    <div class="mb-3">
                        <label asp-for="Username" class="form-label fw-bold">Username</label>
                        <input asp-for="Username" class="form-control" placeholder="Enter username" />
                        <span asp-validation-for="Username" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Password" class="form-label fw-bold">Password</label>
                        <input asp-for="Password" type="password" class="form-control" placeholder="At least 6 characters" />
                        <span asp-validation-for="Password" class="text-danger small"></span>
                    </div>

                    <div class="mb-4">
                        <label asp-for="SelectedRole" class="form-label fw-bold">Role</label>
                        <select asp-for="SelectedRole"
                                asp-items="@(new SelectList(Model.AvailableRoles))"
                                class="form-select">
                        </select>
                        <span asp-validation-for="SelectedRole" class="text-danger small"></span>
                    </div>

                    @if (!ViewData.ModelState.IsValid)
                    {
                        <div class="alert alert-danger small">
                            @Html.ValidationSummary(false, "", new { @class = "mb-0" })
                        </div>
                    }

                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-primary fw-semibold">Create</button>
                        <a asp-area="Admin" asp-controller="Users" asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
