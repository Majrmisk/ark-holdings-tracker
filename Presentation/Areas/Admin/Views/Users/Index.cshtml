@model App.Models.Admin.UserListViewModel
@using Domain
@{
    ViewData["Title"] = "Manage Users";
    bool isSuperAdmin = Model.CallerRole == UserRole.SuperAdmin;
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1>Manage Users</h1>
        <a asp-area="Admin" asp-controller="Users" asp-action="Create" class="btn btn-primary fw-semibold">
            + New User
        </a>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="card shadow-sm">
        <div class="card-body p-0">
            <table class="table table-hover mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Username</th>
                        <th>Role</th>
                        <th>Created</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var user in Model.Users)
                    {
                        bool isProtected = user.Role == nameof(UserRole.SuperAdmin);
                        bool canManage = isSuperAdmin
                            ? user.Role != nameof(UserRole.SuperAdmin)
                            : user.Role == nameof(UserRole.User) || user.Role == nameof(UserRole.PowerUser);

                        <tr>
                            <td class="align-middle">@user.UserName</td>
                            <td class="align-middle">
                                <span class="badge @(isProtected ? "bg-danger" : user.Role == nameof(UserRole.Admin) ? "bg-warning text-dark" : "bg-secondary")">
                                    @user.Role
                                </span>
                            </td>
                            <td class="align-middle text-muted small">@user.CreatedAt.ToString("yyyy-MM-dd HH:mm")</td>
                            <td class="text-end align-middle">
                                @if (canManage)
                                {
                                    <a asp-area="Admin" asp-controller="Users" asp-action="EditRole"
                                       asp-route-id="@user.Id"
                                       class="btn btn-sm btn-outline-primary me-1">Edit Role</a>
                                    <a asp-area="Admin" asp-controller="Users" asp-action="ChangePassword"
                                       asp-route-id="@user.Id"
                                       class="btn btn-sm btn-outline-secondary me-1">Password</a>
                                    <form asp-area="Admin" asp-controller="Users" asp-action="Delete"
                                          asp-route-id="@user.Id" method="post" class="d-inline"
                                          onsubmit="return confirm('Delete user @user.UserName?');">
                                        <button type="submit" class="btn btn-sm btn-outline-danger">Delete</button>
                                    </form>
                                }
                                else
                                {
                                    <span class="text-muted small">—</span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <div class="mt-3">
        <a asp-area="Admin" asp-controller="Home" asp-action="Index" class="btn btn-outline-secondary btn-sm">
            &larr; Back to Dashboard
        </a>
    </div>
</div>
