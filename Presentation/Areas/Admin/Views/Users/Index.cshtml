@model Presentation.Models.Admin.UserListViewModel
@using Domain
@{
    ViewData["Title"] = "Manage Users";
    bool isSuperAdmin = Model.CallerRole == UserRole.SuperAdmin;
}

<div class="mt-4">

    <!-- Header -->
    <div class="flex justify-between items-center mb-6">
        <h1 class="text-3xl font-bold text-gray-900">Manage Users</h1>
        <a asp-area="Admin" asp-controller="Users" asp-action="Create"
           class="inline-flex items-center text-white bg-blue-700 hover:bg-blue-800 focus:ring-4 focus:outline-none focus:ring-blue-300 font-semibold rounded-lg text-sm px-4 py-2.5 dark:bg-blue-600 dark:hover:bg-blue-700 dark:focus:ring-blue-800">
            + New User
        </a>
    </div>

    <!-- Success alert -->
    @if (TempData["Success"] != null)
    {
        <div id="alert-success"
             class="flex items-center p-4 mb-4 text-green-800 rounded-lg bg-green-50 dark:bg-gray-800 dark:text-green-400"
             role="alert">
            <svg class="shrink-0 w-4 h-4" fill="currentColor" viewBox="0 0 20 20">
                <path d="M10 .5a9.5 9.5 0 1 0 9.5 9.5A9.51 9.51 0 0 0 10 .5ZM9.5 4a1.5 1.5 0 1 1 0 3 1.5 1.5 0 0 1 0-3ZM12 15H8a1 1 0 0 1 0-2h1v-3H8a1 1 0 0 1 0-2h2a1 1 0 0 1 1 1v4h1a1 1 0 0 1 0 2Z"/>
            </svg>
            <span class="ml-3 text-sm font-medium">@TempData["Success"]</span>
            <button type="button" data-dismiss-target="#alert-success" aria-label="Close"
                    class="ml-auto -mx-1.5 -my-1.5 bg-green-50 text-green-500 rounded-lg focus:ring-2 focus:ring-green-400 p-1.5 hover:bg-green-200 inline-flex items-center justify-center h-8 w-8 dark:bg-gray-800 dark:text-green-400 dark:hover:bg-gray-700">
                <svg class="w-3 h-3" fill="none" viewBox="0 0 14 14">
                    <path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="m1 1 6 6m0 0 6 6M7 7l6-6M7 7l-6 6"/>
                </svg>
            </button>
        </div>
    }

    <!-- Error alert -->
    @if (TempData["Error"] != null)
    {
        <div id="alert-error"
             class="flex items-center p-4 mb-4 text-red-800 rounded-lg bg-red-50 dark:bg-gray-800 dark:text-red-400"
             role="alert">
            <svg class="shrink-0 w-4 h-4" fill="currentColor" viewBox="0 0 20 20">
                <path d="M10 .5a9.5 9.5 0 1 0 9.5 9.5A9.51 9.51 0 0 0 10 .5ZM9.5 4a1.5 1.5 0 1 1 0 3 1.5 1.5 0 0 1 0-3ZM12 15H8a1 1 0 0 1 0-2h1v-3H8a1 1 0 0 1 0-2h2a1 1 0 0 1 1 1v4h1a1 1 0 0 1 0 2Z"/>
            </svg>
            <span class="ml-3 text-sm font-medium">@TempData["Error"]</span>
            <button type="button" data-dismiss-target="#alert-error" aria-label="Close"
                    class="ml-auto -mx-1.5 -my-1.5 bg-red-50 text-red-500 rounded-lg focus:ring-2 focus:ring-red-400 p-1.5 hover:bg-red-200 inline-flex items-center justify-center h-8 w-8 dark:bg-gray-800 dark:text-red-400 dark:hover:bg-gray-700">
                <svg class="w-3 h-3" fill="none" viewBox="0 0 14 14">
                    <path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="m1 1 6 6m0 0 6 6M7 7l6-6M7 7l-6 6"/>
                </svg>
            </button>
        </div>
    }

    <!-- Table -->
    <div class="relative overflow-x-auto shadow-sm rounded-lg border border-gray-200 dark:border-gray-700">
        <table class="w-full text-sm text-left text-gray-800 dark:text-gray-400">
            <thead class="text-xs text-gray-500 uppercase bg-gray-50 dark:bg-gray-700 dark:text-gray-400">
                <tr>
                    <th scope="col" class="px-6 py-3">Username</th>
                    <th scope="col" class="px-6 py-3">Role</th>
                    <th scope="col" class="px-6 py-3">Created</th>
                    <th scope="col" class="px-6 py-3 text-right">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var user in Model.Users)
                {
                    bool isProtected = user.Role == nameof(UserRole.SuperAdmin);
                    bool canManage = isSuperAdmin
                        ? user.Role != nameof(UserRole.SuperAdmin)
                        : user.Role == nameof(UserRole.User) || user.Role == nameof(UserRole.PowerUser);

                    <tr class="bg-white border-b dark:bg-gray-800 dark:border-gray-700 hover:bg-gray-50 dark:hover:bg-gray-600">
                        <td class="px-6 py-4 font-medium text-gray-900 dark:text-white whitespace-nowrap">
                            @user.UserName
                        </td>
                        <td class="px-6 py-4">
                            <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium
                                @(isProtected
                                    ? "bg-red-100 text-red-800 dark:bg-red-900 dark:text-red-300"
                                    : user.Role == nameof(UserRole.Admin)
                                        ? "bg-yellow-100 text-yellow-800 dark:bg-yellow-900 dark:text-yellow-300"
                                        : "bg-gray-100 text-gray-800 dark:bg-gray-700 dark:text-gray-300")">
                                @user.Role
                            </span>
                        </td>
                        <td class="px-6 py-4 text-gray-500 dark:text-gray-400 text-xs">
                            @user.CreatedAt.ToString("yyyy-MM-dd HH:mm")
                        </td>
                        <td class="px-6 py-4 text-right">
                            @if (canManage)
                            {
                                <div class="inline-flex gap-2">
                                    <a asp-area="Admin" asp-controller="Users" asp-action="EditRole"
                                       asp-route-id="@user.Id"
                                       class="font-medium text-blue-600 hover:underline dark:text-blue-500">
                                        Edit Role
                                    </a>
                                    <a asp-area="Admin" asp-controller="Users" asp-action="ChangePassword"
                                       asp-route-id="@user.Id"
                                       class="font-medium text-gray-600 hover:underline dark:text-gray-400">
                                        Password
                                    </a>
                                    <form asp-area="Admin" asp-controller="Users" asp-action="Delete"
                                          asp-route-id="@user.Id" method="post" class="inline"
                                          onsubmit="return confirm('Delete user @user.UserName?');">
                                        <button type="submit"
                                                class="font-medium text-red-600 hover:underline dark:text-red-500">
                                            Delete
                                        </button>
                                    </form>
                                </div>
                            }
                            else
                            {
                                <span class="text-gray-400 dark:text-gray-600">—</span>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <!-- Back link -->
    <div class="mt-4">
        <a asp-area="Admin" asp-controller="Home" asp-action="Index"
           class="inline-flex items-center text-sm font-medium text-gray-600 hover:text-gray-900 dark:text-gray-400 dark:hover:text-white">
            <svg class="w-4 h-4 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/>
            </svg>
            Back to Dashboard
        </a>
    </div>

</div>
