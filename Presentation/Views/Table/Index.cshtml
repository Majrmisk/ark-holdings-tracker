@using Domain
@model TableViewModel

@{
}

<!DOCTYPE html>

<html>
<head>
    <title>Table</title>
</head>
<body>


<h1>Diff from: @Model.Diff.ComputedAt.ToString("d", System.Globalization.CultureInfo.CurrentCulture)</h1>
<div class="overflow-x-auto">
    <table class="min-w-full divide-y divide-gray-200 border border-gray-200 rounded-lg">
        <thead class="bg-gray-50">
            <tr>
                <th class="px-4 py-3 text-left text-xs font-semibold text-gray-600 uppercase tracking-wider">
                    Company
                </th>
                <th class="px-4 py-3 text-left text-xs font-semibold text-gray-600 uppercase tracking-wider">
                    Ticker
                </th>
                <th class="px-4 py-3 text-right text-xs font-semibold text-gray-600 uppercase tracking-wider">
                    Shares
                </th>
                <th class="px-4 py-3 text-right text-xs font-semibold text-gray-600 uppercase tracking-wider">
                    Weight %
                </th>
                <th class="px-4 py-3 text-left text-xs font-semibold text-gray-600 uppercase tracking-wider">
                    Type
                </th>
            </tr>
        </thead>

        <tbody class="bg-white divide-y divide-gray-100">
            @foreach (var entry in Model.Diff.Entries)
            {
                <tr class="hover:bg-gray-50 transition">
                    <td class="px-4 py-3 text-sm text-gray-900">
                        @entry.Company
                    </td>

                    <td class="px-4 py-3 text-sm text-gray-700 font-medium">
                        @entry.Ticker
                    </td>

                    <td class="px-4 py-3 text-sm text-gray-700 text-right tabular-nums">
                        @entry.Shares
                    </td>

                    <td class="px-4 py-3 text-sm text-gray-700 text-right tabular-nums">
                        @entry.WeightPercent%
                    </td>

                    <td class="px-4 py-3 text-sm">
                        <span class="inline-flex items-center px-2 py-1 rounded-full text-xs font-medium @GetColor(entry.Type)">
                            @entry.Type
                        </span>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

</body>
</html>

@{
    string GetColor(DiffType type)
    {
        return type switch
        {
            DiffType.New => Model.ColorScheme.New,
            DiffType.Increased => Model.ColorScheme.Increased,
            DiffType.Reduced => Model.ColorScheme.Reduced,
            DiffType.Removed => Model.ColorScheme.Removed,
            DiffType.Unchanged => Model.ColorScheme.Unchanged,
            DiffType.WeightShifted => Model.ColorScheme.WeightShifted,
            _ => "",
        };
    }
}