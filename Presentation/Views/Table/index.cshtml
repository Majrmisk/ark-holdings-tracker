@using Domain
@model TableViewModel

@{
}

<!DOCTYPE html>

<html>
<head>
    <title>Table</title>
</head>
<body>

@foreach (var diff in Model.Diffs)
{
    <h1>Diff from: @diff.ComputedAt</h1>
    <table class="border-2">
        @foreach (var entry in diff.Entries)
        {
            

            <tr>
                <td>@entry.Company</td>
                <td>@entry.Ticker</td>
                <td>@entry.Shares</td>
                <td>@entry.WeightPercent</td>
                
                <td class=@GetColor(entry.Type)>
                    @entry.Type
                </td>
                        
                
            </tr>
        }
        
    </table>
}

</body>
</html>

@{
    string GetColor(DiffType type)
    {
        return type switch
        {
            DiffType.New => Model.ColorScheme.New,
            DiffType.Increased => Model.ColorScheme.Increased,
            DiffType.Reduced => Model.ColorScheme.Reduced,
            DiffType.Removed => Model.ColorScheme.Removed,
            DiffType.Unchanged => Model.ColorScheme.Unchanged,
            DiffType.WeightShifted => Model.ColorScheme.WeightShifted,
            _ => "",
        };
    }
}