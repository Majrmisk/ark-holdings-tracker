<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8"/>
    <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
    <title>@ViewData["Title"] - Presentation</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/css/tailwind_styles.css" asp-append-version="true" />
</head>
<body class="flex flex-col min-h-screen">

<header>
    <nav class="bg-white border-b border-gray-200 dark:bg-gray-900">
        <div class="max-w-screen-xl flex flex-wrap items-center justify-between mx-auto p-4">

            <!-- Brand -->
            <a asp-area="" asp-controller="Home" asp-action="Index"
               class="flex items-center space-x-3 rtl:space-x-reverse">
                <span class="self-center text-2xl font-semibold whitespace-nowrap dark:text-white">
                    PV260_notino_team3 Holdings
                </span>
            </a>

            <!-- Right side: auth + hamburger -->
            <div class="flex items-center gap-2 md:order-2 space-x-3 md:space-x-0 rtl:space-x-reverse">

                @if (User.Identity?.IsAuthenticated == true)
                {
                    <span class="text-sm text-gray-500 dark:text-gray-400 hidden md:inline">
                        Welcome, @User.Identity.Name!
                    </span>
                    <form asp-area="" asp-controller="Account" asp-action="Logout" method="post" class="m-0">
                        <button type="submit"
                                class="text-white bg-blue-700 hover:bg-blue-800 focus:ring-4 focus:outline-none focus:ring-blue-300 font-medium rounded-lg text-sm px-4 py-2 dark:bg-blue-600 dark:hover:bg-blue-700 dark:focus:ring-blue-800">
                            Logout
                        </button>
                    </form>
                }
                else
                {
                    <a asp-area="" asp-controller="Account" asp-action="Login"
                       class="text-white bg-blue-700 hover:bg-blue-800 focus:ring-4 focus:outline-none focus:ring-blue-300 font-medium rounded-lg text-sm px-4 py-2 dark:bg-blue-600 dark:hover:bg-blue-700 dark:focus:ring-blue-800">
                        Login
                    </a>
                }

                <!-- Hamburger -->
                <button data-collapse-toggle="navbar-main" type="button"
                        class="inline-flex items-center p-2 w-10 h-10 justify-center text-sm text-gray-500 rounded-lg md:hidden hover:bg-gray-100 focus:outline-none focus:ring-2 focus:ring-gray-200 dark:text-gray-400 dark:hover:bg-gray-700 dark:focus:ring-gray-600"
                        aria-controls="navbar-main" aria-expanded="false">
                    <span class="sr-only">Open main menu</span>
                    <svg class="w-5 h-5" fill="none" viewBox="0 0 17 14" xmlns="http://www.w3.org/2000/svg">
                        <path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                              d="M1 1h15M1 7h15M1 13h15"/>
                    </svg>
                </button>
            </div>

            <!-- Nav links -->
            <div class="items-center justify-between hidden w-full md:flex md:w-auto md:order-1" id="navbar-main">
                <ul class="flex flex-col font-medium p-4 md:p-0 mt-4 border border-gray-100 rounded-lg bg-gray-50
                           md:space-x-8 rtl:space-x-reverse md:flex-row md:mt-0 md:border-0 md:bg-white
                           dark:bg-gray-800 md:dark:bg-gray-900 dark:border-gray-700">
                    <li>
                        <a asp-area="" asp-controller="Home" asp-action="Index"
                           class="block py-2 px-3 text-white bg-blue-700 rounded md:bg-transparent md:hover:text-blue-700 md:p-0 md:hover:dark:text-blue-500"
                           aria-current="page">Home</a>
                    </li>
                    <li>
                        <a asp-area="" asp-controller="Table" asp-action="Index"
                           class="block py-2 px-3 text-gray-900 rounded hover:bg-gray-100 md:hover:bg-transparent md:hover:text-blue-700 md:p-0 dark:text-white md:dark:hover:text-blue-500 dark:hover:bg-gray-700 dark:hover:text-white md:dark:hover:bg-transparent dark:border-gray-700">
                            Diffs
                        </a>
                    </li>
                    <li>
                        <a asp-area="" asp-controller="Home" asp-action="Privacy"
                           class="block py-2 px-3 text-gray-900 rounded hover:bg-gray-100 md:hover:bg-transparent md:hover:text-blue-700 md:p-0 dark:text-white md:dark:hover:text-blue-500 dark:hover:bg-gray-700 dark:hover:text-white md:dark:hover:bg-transparent dark:border-gray-700">
                            Privacy
                        </a>
                    </li>
                    @if (User.IsInRole("Admin") || User.IsInRole("SuperAdmin"))
                    {
                        <li>
                            <a asp-area="Admin" asp-controller="Home" asp-action="Index"
                               class="block py-2 px-3 text-gray-900 rounded hover:bg-gray-100 md:hover:bg-transparent md:hover:text-blue-700 md:p-0 dark:text-white md:dark:hover:text-blue-500 dark:hover:bg-gray-700 dark:hover:text-white md:dark:hover:bg-transparent dark:border-gray-700">
                                Administration
                            </a>
                        </li>
                    }
                </ul>
            </div>

        </div>
    </nav>
</header>

<div class="max-w-screen-xl mx-auto px-4 flex-1">
    <main role="main" class="pb-3 py-6">
        @RenderBody()
    </main>
</div>

<footer class="bg-white border-t border-gray-200 dark:bg-gray-900">
    <div class="max-w-screen-xl mx-auto px-4 py-4 text-sm text-gray-500 dark:text-gray-400">
        &copy; 2026 - Presentation -
        <a asp-area="" asp-controller="Home" asp-action="Privacy"
           class="hover:underline text-blue-600 dark:text-blue-500">Privacy</a>
    </div>
</footer>
<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
<script src="~/js/site.js" asp-append-version="true"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>